module Pvectl
  module Services
    class PushConfig
      DEFAULT_TASK_TIMEOUT: Integer

      @vm_repository: untyped
      @container_repository: untyped
      @task_repository: untyped

      def initialize: (vm_repository: untyped, container_repository: untyped, ?task_repository: untyped) -> void
      def prepare: (String yaml_string) -> Hash[Symbol, untyped]
      def prepare_batch: (Array[Hash[Symbol, untyped]] yaml_contents, ?filter_type: Symbol?) -> Hash[Symbol, untyped]
      def apply: (Array[Hash[Symbol, untyped]] plans) -> Hash[Symbol, untyped]

      private

      def prepare_create: (Symbol type, Hash[Symbol, untyped] metadata, Hash[Symbol, untyped] flat_config, untyped repo, ?vmid: Integer?, ?auto_id: bool) -> Hash[Symbol, untyped]
      def allocate_vmid: (untyped repo, Symbol type) -> Integer
      def repository_for: (Symbol type) -> untyped
      def build_update_params: (Hash[Symbol, untyped] diff, Hash[Symbol, untyped] original_config, Symbol type) -> Hash[Symbol, untyped]
      def apply_resize_ops: (untyped repo, Hash[Symbol, untyped] plan) -> Array[String]
      def wait_for_task: (untyped upid) -> untyped
      def vm_disk_key?: (Symbol | String key) -> bool
      def create_disk_key?: (Symbol | String key, Symbol type) -> bool
      def transform_disks_for_create: (Hash[Symbol, untyped] flat_config, Symbol type) -> Hash[Symbol, untyped]
      def disk_value_for_create: (String value) -> String
      def size_to_gib: (String size_str) -> String
      def extract_disk_size: (String disk_value) -> String?
      def disk_value_without_size: (String value) -> String
      def replace_disk_size: (String value, String size) -> String
      def collect_readonly_keys: (Hash[Symbol, untyped] flat_config, Symbol type) -> Array[Symbol]
      def each_leaf_section: (Hash[Symbol, untyped] sections) { (Hash[Symbol, untyped]) -> void } -> void
      def type_label: (Symbol type) -> String
      def extract_api_error: (untyped exception) -> String
    end
  end
end
