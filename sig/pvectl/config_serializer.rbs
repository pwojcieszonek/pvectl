module Pvectl
  module ConfigSerializer
    VM_SECTIONS: Hash[Symbol, Hash[Symbol, Array[Symbol] | Array[Regexp] | Hash[Symbol, Hash[Symbol, Array[Symbol] | Array[Regexp]]]]]

    CONTAINER_SECTIONS: Hash[Symbol, Hash[Symbol, Array[Symbol] | Array[Regexp] | Hash[Symbol, Hash[Symbol, Array[Symbol] | Array[Regexp]]]]]

    YAML_SPECIAL_CHARS: Array[String]

    AGENT_DEFAULTS: Hash[Symbol, String]

    VM_DEFAULTS: Hash[Symbol, String]

    VM_BOOLEAN_KEYS: Array[Symbol]

    CT_BOOLEAN_KEYS: Array[Symbol]

    HOTPLUG_CAPABILITIES: Array[Symbol]

    AGENT_BOOLEAN_SUBKEYS: Array[Symbol]

    NET_BOOLEAN_SUBKEYS: Array[Symbol]

    DISK_BOOLEAN_SUBKEYS: Array[Symbol]

    VM_COMPLEX_KEYS: Hash[Symbol, Hash[Symbol, Regexp | Symbol]]

    CT_COMPLEX_KEYS: Hash[Symbol, Hash[Symbol, Regexp | Symbol]]

    def self.to_yaml: (Hash[Symbol, untyped] flat_config, type: Symbol, ?resource: Hash[Symbol, untyped]) -> String

    def self.from_yaml: (String yaml_string, type: Symbol) -> Hash[Symbol, untyped]

    def self.validate: (String yaml_string, type: Symbol) -> Array[String]

    def self.readonly_violations: (Hash[Symbol, untyped] original_flat, Hash[Symbol, untyped] edited_flat, type: Symbol) -> Array[String]

    def self.diff: (Hash[Symbol, untyped] original, Hash[Symbol, untyped] edited) -> Hash[Symbol, Hash[Symbol, untyped] | Array[Symbol]]

    def self.format_diff: (Hash[Symbol, untyped] diff_hash) -> String

    def self.to_nested: (Hash[Symbol, untyped] flat_config, type: Symbol) -> Hash[Symbol, Hash[Symbol, untyped]]

    def self.from_nested: (Hash[Symbol, untyped] nested, type: Symbol) -> Hash[Symbol, untyped]

    private

    def self.sections_for: (Symbol type) -> Hash[Symbol, untyped]

    def self.header_comment: (Symbol type, Hash[Symbol, untyped] resource) -> String

    def self.keys_for_section: (Hash[Symbol, untyped] config, Hash[Symbol, Array[Symbol] | Array[Regexp]] section_def) -> Array[Symbol]

    def self.key_in_section?: (Symbol key, Hash[Symbol, Array[Symbol] | Array[Regexp]] section_def) -> bool

    def self.readonly_key?: (Symbol key, Hash[Symbol, Array[Symbol] | Array[Regexp]] section_def) -> bool

    def self.collect_readonly_keys: (Array[Symbol] keys, Hash[Symbol, untyped] sections) -> Array[Symbol]

    def self.format_yaml_value: (untyped value) -> String

    def self.needs_quoting?: (String value) -> bool

    def self.strip_comments: (String yaml_string) -> String

    def self.wrapper_section?: (Hash[Symbol, untyped] section_def) -> bool

    def self.inject_defaults: (Hash[Symbol, untyped] flat_config, Symbol type) -> Hash[Symbol, untyped]

    def self.to_boolean: (untyped value) -> (bool | untyped)

    def self.from_boolean: (untyped value) -> (Integer | untyped)

    def self.boolean_keys_for: (Symbol type) -> Array[Symbol]

    def self.render_leaf_section: (Array[String] lines, Symbol section_name, Hash[Symbol, Array[Symbol] | Array[Regexp]] section_def, Hash[Symbol, untyped] flat_config) -> void

    def self.render_wrapper_section: (Array[String] lines, Symbol wrapper_name, Hash[Symbol, untyped] wrapper_def, Hash[Symbol, untyped] flat_config) -> void

    def self.validate_wrapper_section: (Array[String] errors, String wrapper_name, Hash[Symbol, untyped] wrapper_def, Hash[String, untyped] wrapper_values) -> void

    def self.each_leaf_section: (Hash[Symbol, untyped] sections) -> Array[Hash[Symbol, Array[Symbol] | Array[Regexp]]]

    def self.flatten_sections: (Hash[String, untyped] parsed) -> Hash[Symbol, untyped]

    def self.complex_keys_for: (Symbol type) -> Hash[Symbol, Hash[Symbol, Regexp | Symbol]]

    def self.find_complex_key: (Symbol key, Symbol type) -> Hash[Symbol, Regexp | Symbol]?

    def self.build_nested_section: (Hash[Symbol, untyped] flat_config, Hash[Symbol, Array[Symbol] | Array[Regexp]] section_def, Symbol type) -> Hash[Symbol, untyped]

    def self.flatten_nested_section: (Hash[Symbol, untyped] section_hash, Symbol type, Hash[Symbol, untyped] result) -> void

    def self.parse_vm_net_value: (String string) -> Hash[Symbol, untyped]

    def self.serialize_vm_net_value: (Hash[Symbol, untyped] hash) -> String

    def self.normalize_cloudinit_volume: (untyped parsed) -> untyped

    def self.parse_disk_value: (String string) -> Hash[Symbol, untyped]

    def self.serialize_disk_value: (Hash[Symbol, untyped] hash) -> String

    def self.parse_kv_value: (String string, ?default_key: Symbol?) -> Hash[Symbol, String?]

    def self.serialize_kv_value: (Hash[Symbol, String] hash) -> String

    def self.parse_agent_value: (String string) -> Hash[Symbol, untyped]

    def self.serialize_agent_value: (Hash[Symbol, untyped] hash) -> String

    def self.parse_boot_value: (String string) -> Hash[Symbol, String | Array[String]]

    def self.serialize_boot_value: (Hash[Symbol, String | Array[String]] hash) -> String

    def self.parse_hotplug_value: (String string) -> Hash[Symbol, bool]

    def self.serialize_hotplug_value: (Hash[Symbol, bool] hash) -> String
  end
end
