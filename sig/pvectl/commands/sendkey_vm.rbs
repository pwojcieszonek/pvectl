module Pvectl
  module Commands
    class SendkeyVm
      def self.register: (untyped cli) -> void

      def self.execute: (Array[String] args, Hash[Symbol, untyped] options, Hash[Symbol, untyped] global_options) -> Integer

      def initialize: (Array[String] args, Hash[Symbol, untyped] options, Hash[Symbol, untyped] global_options) -> void

      def execute: () -> Integer

      private

      def perform_sendkey: (Integer vmid, String key) -> Integer

      def vm_not_found?: (Models::VmOperationResult result) -> bool

      def load_config: () -> void

      def output_result: (Models::VmOperationResult result) -> void

      def usage_error: (String message) -> Integer
    end
  end
end
